# Required. PostgreSQL connection string (Neon, Render Postgres, etc.).
# Neon requires SSL: keep ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Required. Shared secret the ESP8266 controller sends as
# "Authorization: Bearer <key>" on every controller API request.
DEVICE_API_KEY=change-me

# Optional. Public base URL of this service, used when configuring the
# controller firmware. On Render this is https://<service>.onrender.com
API_BASE_URL=https://your-service.onrender.com

# Required for voice transcription. Google Gemini API key used by
# /api/transcribe (model gemini-3.5-transcribe). Get one at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
