; ffi-napi (a vosk dependency) ships N-API prebuilds for linux/mac/win, but its
; install script runs `node-gyp-build-test`, which can crash on modern Node
; teardown and then falls back to a source build (fails without a C++ toolchain).
; Disabling install scripts keeps the shipped prebuilds and lets vosk load them
; at runtime on Node 20/22/24.
ignore-scripts=true
